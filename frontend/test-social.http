###############################################################################
# TEST SOCIAL - Scénario complet de partage entre amis
# 
# Ce script simule le parcours suivant :
# 1. User A (mamadbah) se connecte et récupère son token
# 2. User B (cheimbaye) se connecte et récupère son token
# 3. User A suit User B
# 4. User A ajoute 'Inception' à sa watchlist
# 5. User A partage 'Inception' avec User B (avec message personnalisé)
# 6. User B appelle /api/recommendations et voit 'Inception' en tête (boost social)
# 7. Tests d'erreurs (partage sans follow, etc.)
# 8. Profils utilisateur avec statistiques
# 9. Reviews et Batch endpoint
###############################################################################

@baseUrl = http://localhost:5050
@tmdbId = 27205

# Tokens - à récupérer dynamiquement
@tokenUserA = {{loginUserA.response.body.access_token}}
@tokenUserB = {{loginUserB.response.body.access_token}}
@refreshTokenA = {{loginUserA.response.body.refresh_token}}
@refreshTokenB = {{loginUserB.response.body.refresh_token}}

# IDs utilisateurs (récupérés via /me)
@userAId = {{getUserA.response.body.id}}
@userBId = {{getUserB.response.body.id}}

###############################################################################
# ÉTAPE 1 : AUTHENTIFICATION
###############################################################################

### 1.1 Login User A (mamadbah)
# @name loginUserA
POST http://keycloak4flix.duckdns.org/realms/neo4flix/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=neo4flix-app&username=mamadbah&password=password123

### 1.2 Login User B (cheimbaye)
# @name loginUserB
POST http://keycloak4flix.duckdns.org/realms/neo4flix/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=neo4flix-app&username=cheimbaye&password=password123

### 1.3 Récupérer les infos de User A
# @name getUserA
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{tokenUserA}}

### 1.4 Récupérer les infos de User B
# @name getUserB
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{tokenUserB}}

###############################################################################
# ÉTAPE 2 : USER A SUIT USER B
###############################################################################

### 2.1 User A suit User B
POST {{baseUrl}}/api/users/follow/{{userBId}}
Authorization: Bearer {{tokenUserA}}

### 2.2 Vérifier que User A suit User B
GET {{baseUrl}}/api/users/following/{{userBId}}
Authorization: Bearer {{tokenUserA}}

### 2.3 Voir la liste des following de User A
GET {{baseUrl}}/api/users/following
Authorization: Bearer {{tokenUserA}}

### 2.4 Voir les followers de User B (devrait contenir User A)
GET {{baseUrl}}/api/users/followers
Authorization: Bearer {{tokenUserB}}

###############################################################################
# ÉTAPE 3 : USER A AJOUTE INCEPTION À SA WATCHLIST
###############################################################################

### 3.1 User A ajoute Inception à sa watchlist
POST {{baseUrl}}/api/users/watchlist/{{tmdbId}}
Authorization: Bearer {{tokenUserA}}

### 3.2 Vérifier la watchlist de User A
GET {{baseUrl}}/api/users/watchlist
Authorization: Bearer {{tokenUserA}}

###############################################################################
# ÉTAPE 4 : USER A PARTAGE INCEPTION AVEC USER B (avec message)
###############################################################################

### 4.1 User A partage Inception avec User B (avec message personnalisé)
POST {{baseUrl}}/api/recommendations/share
Authorization: Bearer {{tokenUserA}}
Content-Type: application/json

{
  "targetUserId": "{{userBId}}",
  "tmdbId": {{tmdbId}},
  "message": "Tu dois absolument voir ce film, il est incroyable !"
}

### 4.2 Partage sans message (optionnel)
POST {{baseUrl}}/api/recommendations/share
Authorization: Bearer {{tokenUserA}}
Content-Type: application/json

{
  "targetUserId": "{{userBId}}",
  "tmdbId": 155
}

###############################################################################
# ÉTAPE 5 : USER B VOIT INCEPTION BOOSTÉ DANS SES RECOMMANDATIONS
###############################################################################

### 5.1 User B récupère ses recommandations (Inception devrait être en tête grâce au boost social)
GET {{baseUrl}}/api/recommendations/
Authorization: Bearer {{tokenUserA}}


### 5 User B récupère ses recommandations (Inception devrait être en tête grâce au boost social)
GET {{baseUrl}}/api/recommendations/
Authorization: Bearer {{tokenUserA}}

### 5.2 User B récupère uniquement les films partagés par ses amis
GET {{baseUrl}}/api/recommendations/shared
Authorization: Bearer {{tokenUserB}}

###############################################################################
# ÉTAPE 6 : TESTS D'ERREURS
###############################################################################

### 6.1 ERREUR - User B essaie de partager avec User A (qu'il ne suit pas) -> 403 Forbidden
POST {{baseUrl}}/api/recommendations/share
Authorization: Bearer {{tokenUserB}}
Content-Type: application/json

{
  "targetUserId": "{{userAId}}",
  "tmdbId": {{tmdbId}}
}

### 6.2 ERREUR - Partager avec soi-même -> 400 Bad Request
POST {{baseUrl}}/api/recommendations/share
Authorization: Bearer {{tokenUserA}}
Content-Type: application/json

{
  "targetUserId": "{{userAId}}",
  "tmdbId": {{tmdbId}}
}

### 6.3 ERREUR - Partager un film inexistant -> 404 Not Found
POST {{baseUrl}}/api/recommendations/share
Authorization: Bearer {{tokenUserA}}
Content-Type: application/json

{
  "targetUserId": "{{userBId}}",
  "tmdbId": 999999999
}

### 6.4 ERREUR - Requête sans targetUserId -> 400 Bad Request (validation)
POST {{baseUrl}}/api/recommendations/share
Authorization: Bearer {{tokenUserA}}
Content-Type: application/json

{
  "tmdbId": {{tmdbId}}
}

### 6.5 ERREUR - Requête sans tmdbId -> 400 Bad Request (validation)
POST {{baseUrl}}/api/recommendations/share
Authorization: Bearer {{tokenUserA}}
Content-Type: application/json

{
  "targetUserId": "{{userBId}}"
}

###############################################################################
# ÉTAPE 7 : NETTOYAGE (OPTIONNEL)
###############################################################################

### 7.1 User A unfollow User B
DELETE {{baseUrl}}/api/users/follow/{{userBId}}
Authorization: Bearer {{tokenUserA}}

### 7.2 User A supprime Inception de sa watchlist
DELETE {{baseUrl}}/api/users/watchlist/{{tmdbId}}
Authorization: Bearer {{tokenUserA}}

###############################################################################
# ÉTAPE 8 : PROFILS UTILISATEUR AVEC STATISTIQUES
###############################################################################

### 8.1 Mon profil avec statistiques
GET {{baseUrl}}/api/users/profile
Authorization: Bearer {{tokenUserA}}

### 8.2 Profil d'un autre utilisateur
GET {{baseUrl}}/api/users/profile/{{userBId}}
Authorization: Bearer {{tokenUserA}}

###############################################################################
# ÉTAPE 9 : REVIEWS ET BATCH ENDPOINT
###############################################################################

### 9.1 Récupérer les avis d'un film (paginé)
GET {{baseUrl}}/api/movies/{{tmdbId}}/reviews?page=1&size=5&language=fr-FR

### 9.2 Récupérer plusieurs films en une seule requête (Batch)
POST {{baseUrl}}/api/movies/batch
Content-Type: application/json

{
  "tmdbIds": [27205, 155, 603, 550],
  "language": "fr-FR"
}

###############################################################################
# ÉTAPE 10 : NOTER UN FILM AVEC COMMENTAIRE
###############################################################################

### 10.1 Noter un film avec commentaire
POST {{baseUrl}}/api/rates/
Authorization: Bearer {{tokenUserB}}
Content-Type: application/json

{
  "tmdbId": {{tmdbId}},
  "score": 5,
  "comment": "Un chef-d'œuvre absolu de Christopher Nolan !"
}

### 10.2 Noter un film sans commentaire
POST {{baseUrl}}/api/rates/
Authorization: Bearer {{tokenUserB}}
Content-Type: application/json

{
  "tmdbId": {{tmdbId}},
  "score": 8
}

###############################################################################
# ÉTAPE 11 : RATINGS D'UN FILM (NOUVEAU)
###############################################################################

### 11.1 Récupérer les ratings d'un film (paginé) - Endpoint public
GET {{baseUrl}}/api/rates/movie/{{tmdbId}}?page=1&size=10

### 11.2 Récupérer les ratings avec pagination page 2
GET {{baseUrl}}/api/rates/movie/{{tmdbId}}?page=2&size=5

###############################################################################
# ÉTAPE 12 : DÉCOUVERTE D'UTILISATEURS (NOUVEAU)
###############################################################################

### 12.1 Découvrir des utilisateurs à suivre (paginé, tri aléatoire)
GET {{baseUrl}}/api/users/discover?page=1&size=10
Authorization: Bearer {{tokenUserA}}

### 12.2 Découvrir des utilisateurs - Page 2
GET {{baseUrl}}/api/users/discover?page=2&size=5
Authorization: Bearer {{tokenUserB}}

###############################################################################
# BONUS : REFRESH TOKENS
###############################################################################

### Refresh token User A
# @name refreshUserA
POST http://keycloak4flix.duckdns.org/realms/neo4flix/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token&client_id=neo4flix-app&refresh_token={{refreshTokenA}}

### Refresh token User B
# @name refreshUserB
POST http://keycloak4flix.duckdns.org/realms/neo4flix/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token&client_id=neo4flix-app&refresh_token={{refreshTokenB}}
